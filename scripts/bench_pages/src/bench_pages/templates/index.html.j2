<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>SOL Sweep Registry</title>
    <link rel="stylesheet" href="assets/site.css">
  </head>
  <body>
    <header class="header-strip">
      <div class="header-id">
        <span class="header-label">REGISTRY</span>
        <h1 class="header-title">SOL Sweep History</h1>
      </div>
    </header>

    <main class="page-shell">
      <section class="panel">
        <h2 class="panel-title">Published Sweeps</h2>
        <div class="table-scroll">
          <table class="data-table">
            <thead>
              <tr>
                <th>Sweep</th>
                <th>Mode</th>
                <th>Fixture</th>
                <th>Verdict</th>
              </tr>
            </thead>
            <tbody>
              {% for entry in entries %}
              <tr>
                <td><a href="{{ entry.path }}">{{ entry.id }}</a></td>
                <td>{{ entry.execution_mode }}</td>
                <td class="cell-mono">{{ entry.fixture_identity }}</td>
                <td class="cell-verdict verdict-{{ entry.verdict | lower }}">{{ entry.verdict }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </body>
</html>
