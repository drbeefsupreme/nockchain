<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ sweep.id }}</title>
    <link rel="stylesheet" href="../../assets/site.css">
  </head>
  <body>
    <header class="header-strip">
      <div class="header-id">
        <span class="header-label">SWEEP</span>
        <h1 class="header-title">{{ sweep.id }}</h1>
      </div>
      <div class="header-meta">
        <span><em>Mode</em> {{ sweep.execution_mode }}</span>
        <span><em>Fixture</em> {{ sweep.fixture_identity or 'n/a' }}</span>
        <span><em>Commit</em> {{ (sweep.git_commit or 'n/a')[:12] }}</span>
        <span><em>Verdict</em> <strong class="verdict-{{ (sweep.verdict.validity if sweep.verdict is mapping else sweep.verdict)|lower }}">{{ sweep.verdict.validity if sweep.verdict is mapping else sweep.verdict }}</strong></span>
        {% if sweep.axis_names %}
        <span><em>Axes</em> {{ sweep.axis_names | join(', ') }}</span>
        {% endif %}
        {% if sweep.build_profile %}
        <span><em>Profile</em> {{ sweep.build_profile }}</span>
        {% endif %}
        {% if top_level_artifacts %}
        <span><em>Artifacts</em> {{ artifact_inventory | length }} files</span>
        {% endif %}
      </div>
    </header>

    <main class="page-shell">
      <section class="panel">
        <h2 class="panel-title">Cross-Case Comparison</h2>
        <div class="table-scroll">
          <table class="data-table comparison-table">
            <thead>
              <tr>
                <th title="Benchmark case identifier">Case</th>
                <th title="Variable parameters for this case">Axes</th>
                <th title="Validity assessment of benchmark results">Verdict</th>
                {% for col in comparison.columns %}
                <th{% if col.tooltip %} title="{{ col.tooltip }}"{% endif %}>{{ col.label }}</th>
                {% endfor %}
                <th title="Number of runs that failed">Failed</th>
              </tr>
            </thead>
            <tbody>
              {% for row in comparison.rows %}
              <tr>
                <td class="cell-id"><a href="#case-{{ row.case_id }}">{{ row.case_id }}</a></td>
                <td class="cell-mono">{{ row.axis_summary }}</td>
                <td class="cell-verdict verdict-{{ row.verdict_label | lower }}" title="{{ row.verdict_tooltip }}">{{ row.verdict_label }}</td>
                {% for cell in row.cells %}
                <td class="cell-metric"{% if cell.tooltip %} title="{{ cell.tooltip }}"{% endif %}>{{ cell.markup }}</td>
                {% endfor %}
                <td class="cell-metric">{{ row.failed_count }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </section>

      {% if strip_charts %}
      <section class="panel">
        <h2 class="panel-title">Run Spread</h2>
        {% for chart in strip_charts %}
        <details class="strip-chart-wrapper">
          <summary class="strip-chart-toggle">{{ chart.label }}</summary>
          {{ chart.svg }}
        </details>
        {% endfor %}
      </section>
      {% endif %}

      {% for section in case_sections %}
      <section class="panel" id="case-{{ section.case.case_id }}">
        <h2 class="panel-title">{{ section.case.case_id }}</h2>
        <div class="case-meta">
          {% for key, value in section.case.axis_assignments.items() %}
          <span><em>{{ key }}</em> {{ value }}</span>
          {% endfor %}
          <span><em>Verdict</em> <strong class="verdict-{{ section.verdict_label | lower }}">{{ section.verdict_label }}</strong></span>
          <span><em>Mode</em> {{ section.case.execution_mode }}</span>
        </div>

        {% if section.samply_profile %}
        <div class="profile-bar">
          <span class="profile-badge">CPU PROFILE</span>
          <a href="../../{{ section.samply_profile.href }}" class="btn-small" title="Download samply profile (.json.gz)" download>Download</a>
          <button class="btn-small profile-open-btn" data-profile-href="../../{{ section.samply_profile.href }}" title="Load profile and open in Firefox Profiler">Open in Firefox Profiler</button>
        </div>
        {% endif %}

        {% for run_table in section.run_tables %}
        <h3 class="section-label">Runs</h3>
        <div class="table-scroll">
          <table class="data-table run-table">
            <thead>
              <tr>
                <th>Run</th>
                {% for col in run_table.columns %}
                <th{% if col.tooltip %} title="{{ col.tooltip }}"{% endif %}>{{ col.label }}</th>
                {% endfor %}
                <th>Files</th>
              </tr>
            </thead>
            <tbody>
              {% for row in run_table.rows %}
              <tr>
                <td class="cell-mono">{{ row.run_id }}</td>
                {% for cell in row.cells %}
                <td class="cell-metric"{% if cell.tooltip %} title="{{ cell.tooltip }}"{% endif %}>{{ cell.markup }}</td>
                {% endfor %}
                <td class="cell-artifacts">
                  {% if row.artifacts %}
                  <details class="inline-details">
                    <summary>{{ row.artifacts | length }}</summary>
                    <ul class="artifact-links">
                      {% for artifact in row.artifacts %}
                      <li><a href="../../{{ artifact.href }}">{{ artifact.relative_path }}</a></li>
                      {% endfor %}
                    </ul>
                  </details>
                  {% else %}
                  <span class="na">&mdash;</span>
                  {% endif %}
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% endfor %}
      </section>
      {% endfor %}

      <section class="panel" id="evidence-browser-section">
        <h2 class="panel-title">Case Evidence Browser</h2>
        <div class="browser-layout" id="evidence-browser">
          <nav class="browser-nav">
            <div class="browser-cases">
              {% for section in case_sections %}
              <button class="browser-case-tab{% if loop.first %} active{% endif %}" data-case="{{ loop.index0 }}">{{ section.case.case_id }}</button>
              {% endfor %}
            </div>
            {% for section in case_sections %}
            <ul class="browser-items{% if loop.first %} active{% endif %}" data-case="{{ loop.index0 }}">
              <li><button class="browser-item" data-panel="prov-{{ loop.index0 }}">Provenance</button></li>
              <li><button class="browser-item" data-panel="req-{{ loop.index0 }}">Requested Case</button></li>
              <li><button class="browser-item" data-panel="res-{{ loop.index0 }}">Resolved Case</button></li>
              <li><button class="browser-item" data-panel="verd-{{ loop.index0 }}">Verdict Detail</button></li>
              {% if section.validation_markup %}
              <li><button class="browser-item" data-panel="val-{{ loop.index0 }}">Validation</button></li>
              {% endif %}
              <li><button class="browser-item" data-panel="sum-{{ loop.index0 }}">Summary (full)</button></li>
              <li><button class="browser-item" data-panel="raw-{{ loop.index0 }}">Raw JSON</button></li>
            </ul>
            {% endfor %}
          </nav>
          <div class="browser-content" id="browser-content">
            {% for section in case_sections %}
            <div class="browser-panel" id="prov-{{ loop.index0 }}" data-case="{{ loop.index0 }}">
              <h3 class="browser-panel-title">Provenance &mdash; {{ section.case.case_id }}</h3>
              {{ section.provenance_markup }}
            </div>
            <div class="browser-panel" id="req-{{ loop.index0 }}" data-case="{{ loop.index0 }}">
              <h3 class="browser-panel-title">Requested Case &mdash; {{ section.case.case_id }}</h3>
              {{ section.requested_case_markup }}
            </div>
            <div class="browser-panel" id="res-{{ loop.index0 }}" data-case="{{ loop.index0 }}">
              <h3 class="browser-panel-title">Resolved Case &mdash; {{ section.case.case_id }}</h3>
              {{ section.resolved_case_markup }}
            </div>
            <div class="browser-panel" id="verd-{{ loop.index0 }}" data-case="{{ loop.index0 }}">
              <h3 class="browser-panel-title">Verdict &mdash; {{ section.case.case_id }}</h3>
              {{ section.verdict_markup }}
            </div>
            {% if section.validation_markup %}
            <div class="browser-panel" id="val-{{ loop.index0 }}" data-case="{{ loop.index0 }}">
              <h3 class="browser-panel-title">Validation &mdash; {{ section.case.case_id }}</h3>
              {{ section.validation_markup }}
            </div>
            {% endif %}
            <div class="browser-panel" id="sum-{{ loop.index0 }}" data-case="{{ loop.index0 }}">
              <h3 class="browser-panel-title">Summary (full) &mdash; {{ section.case.case_id }}</h3>
              {{ section.summary_markup }}
            </div>
            <div class="browser-panel" id="raw-{{ loop.index0 }}" data-case="{{ loop.index0 }}">
              <h3 class="browser-panel-title">Raw JSON &mdash; {{ section.case.case_id }}</h3>
              <pre>{{ pretty_json(section.case) }}</pre>
            </div>
            {% endfor %}
            <div class="browser-empty" id="browser-empty">Select an evidence item from the list.</div>
          </div>
        </div>
      </section>

      {% if docker_images %}
      <section class="panel">
        <h2 class="panel-title">Docker Images</h2>
        <div class="table-scroll">
          <table class="data-table">
            <thead>
              <tr>
                <th>Identity</th>
                <th>Local Ref</th>
                <th>Provenance Digest</th>
                <th>GHCR Tag</th>
                <th>GHCR Digest</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              {% for image in docker_images %}
              <tr>
                <td class="cell-mono">{{ image.canonical_identity }}</td>
                <td>{{ image.local_image_ref or 'n/a' }}</td>
                <td class="cell-mono">{{ image.provenance_image_digest or 'n/a' }}</td>
                <td>{{ image.ghcr_tag or 'n/a' }}</td>
                <td class="cell-mono">{{ image.ghcr_digest or 'n/a' }}</td>
                <td>{{ image.publish_status or 'planned' }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </section>
      {% endif %}

      <section class="panel">
        <h2 class="panel-title">Artifact Browser</h2>
        <div class="table-scroll">
          <table class="data-table artifact-table">
            <thead>
              <tr>
                <th>Path</th>
                <th>Size</th>
              </tr>
            </thead>
            <tbody>
              {% for artifact in artifact_inventory %}
              <tr>
                <td><a href="../../{{ artifact.href }}">{{ artifact.relative_path }}</a></td>
                <td class="cell-mono cell-right">{{ artifact.size_bytes }} B</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </section>
    </main>

    <script>
    (function() {
      var caseTabs = document.querySelectorAll('.browser-case-tab');
      var itemLists = document.querySelectorAll('.browser-items');
      var allItems = document.querySelectorAll('.browser-item');
      var panels = document.querySelectorAll('.browser-panel');
      var emptyMsg = document.getElementById('browser-empty');

      // Hide all panels initially.
      panels.forEach(function(p) { p.style.display = 'none'; });

      function updateEmpty() {
        var anyVisible = false;
        panels.forEach(function(p) {
          if (p.style.display !== 'none') anyVisible = true;
        });
        if (emptyMsg) emptyMsg.style.display = anyVisible ? 'none' : '';
      }

      function clearSelection() {
        allItems.forEach(function(i) { i.classList.remove('active'); });
        panels.forEach(function(p) { p.style.display = 'none'; });
      }

      // Case tab switching.
      caseTabs.forEach(function(tab) {
        tab.addEventListener('click', function() {
          var idx = this.dataset['case'];
          caseTabs.forEach(function(t) { t.classList.remove('active'); });
          this.classList.add('active');
          itemLists.forEach(function(list) {
            if (list.dataset['case'] === idx) {
              list.classList.add('active');
            } else {
              list.classList.remove('active');
            }
          });
          clearSelection();
          updateEmpty();
        });
      });

      // Single-select: one card at a time.
      allItems.forEach(function(item) {
        item.addEventListener('click', function() {
          var panelId = this.dataset.panel;
          var panel = document.getElementById(panelId);
          if (!panel) return;
          var wasActive = this.classList.contains('active');
          clearSelection();
          if (!wasActive) {
            this.classList.add('active');
            panel.style.display = '';
          }
          updateEmpty();
        });
      });
    })();

    // Open samply profiles in Firefox Profiler.
    // Fetches the .json.gz locally, decompresses, then injects into a new
    // Profiler tab via postMessage — works on file://, localhost, and Pages.
    document.querySelectorAll('.profile-open-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var href = this.dataset.profileHref;
        var self = this;
        self.textContent = 'Loading\u2026';
        self.disabled = true;
        fetch(href)
          .then(function(r) {
            if (!r.ok) throw new Error('HTTP ' + r.status);
            return r.arrayBuffer();
          })
          .then(function(compressed) {
            var ds = new DecompressionStream('gzip');
            var reader = new Blob([compressed]).stream().pipeThrough(ds).getReader();
            var chunks = [];
            function pump() {
              return reader.read().then(function(result) {
                if (result.done) return new Blob(chunks);
                chunks.push(result.value);
                return pump();
              });
            }
            return pump();
          })
          .then(function(blob) { return blob.text(); })
          .then(function(jsonText) {
            var profile = JSON.parse(jsonText);
            var profilerOrigin = 'https://profiler.firefox.com';
            var profilerWindow = window.open(profilerOrigin + '/from-post-message/');
            if (!profilerWindow) {
              alert('Pop-up blocked. Please allow pop-ups for this site.');
              return;
            }
            // The Profiler listens for this message once the page loads.
            function trySend() {
              profilerWindow.postMessage({type: 'PROFILE_AND_THREADS_FROM_OPENER', profile: profile}, profilerOrigin);
            }
            // Retry a few times since the Profiler page needs to load first.
            var attempts = 0;
            var timer = setInterval(function() {
              trySend();
              attempts++;
              if (attempts > 20) clearInterval(timer);
            }, 250);
          })
          .catch(function(err) {
            alert('Failed to load profile: ' + err.message);
          })
          .finally(function() {
            self.textContent = 'Open in Firefox Profiler';
            self.disabled = false;
          });
      });
    });
    </script>
  </body>
</html>
